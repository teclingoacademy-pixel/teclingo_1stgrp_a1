// ═══════════════════════════════════════════════════════════════
// TECLINGO - Prisma Schema
// ═══════════════════════════════════════════════════════════════

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ═══════════════════════════════════════════════════════════════
// USUARIOS Y AUTENTICACIÓN
// ═══════════════════════════════════════════════════════════════

model User {
  examResults   ExamResult[]
  studentPresentation StudentPresentation?
  pronunciationAttempts PronunciationAttempt[]
  userSessions UserSession[]
  userActivities UserActivity[]
  pushSubscriptions PushSubscription[]
  notificationPreference NotificationPreference?
  id              String           @id @default(uuid())
  email           String           @unique
  name            String?
  password        String?
  role            Role             @default(STUDENT)
  streakDays      Int              @default(0)
  totalXp         Int              @default(0)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  sheetId         String?          @unique
  metodo          String?
  nikName         String?
  nivel           String?
  avatar          String?
  lastAccess      DateTime?
  active          Boolean          @default(true)
  directorProfile DirectorProfile?
  teacherProfile  TeacherProfile?
  studentProfile  StudentProfile?
  groupMembers    GroupMember[]
  submissions     Submission[]
  userProgress    UserProgress[]
  attendances     Attendance[]
  goals           Goal[]
  achievements    Achievement[]
  credentials      Credential?
  conversations ConversationMember[]
  messages      Message[]
}

model Credential {
  id               String   @id @default(uuid())
  userId           String   @unique
  avatarUrl        String?
  controlValue     String?
  nivel            String?
  grupo            String?
  career           String?
  semestre         String?
  modulo           String?
  modalidad        String?
  institutionCode  String?
  institutionName  String?
  institutionLogoUrl String?
  slogan           String?
  curp             String?
  email            String?
  roleLabel        String?
  chips            String[]
  qrValue          String?
  issuedAt         DateTime @default(now())
  updatedAt        DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ═══════════════════════════════════════════════════════════════
// LECCIONES Y CONTENIDO PEDAGÓGICO
// ═══════════════════════════════════════════════════════════════

model Lesson {
  id           String         @id
  level        String
  title        String
  description  String?
  order        Int            @default(1)
  isPublished  Boolean        @default(true)
  createdAt    DateTime       @default(now())
  weekId       String?
  week         StudyWeek?     @relation(fields: [weekId], references: [id], onDelete: SetNull)
  exercises    Exercise[]
  userProgress UserProgress[]
  texts        TextBase[]
  vocabulary   VocabularyItem[]
  teacherScript TeacherScript?
  theorySections   LessonTheorySection[]
  knowledgeMap     ClassKnowledgeMap?
  contract         LessonContract?
  curriculum       LessonCurriculum?
  grammarTips      LessonGrammarTip[]
  quickVocab       LessonQuickVocab[]
  mallaWeeks       MallaWeek[]           @relation("MallaWeekLessons")

  @@index([weekId])
  videoUrl        String?
  tituloVideo     String?
  temaPrincipal   String?
  tipoContenido   String?
  duracionMin     Int?
  semana          Int?
  sesion          String?
}

model StudyLevel {
  id          String      @id @default(uuid())
  code        String      @unique
  semester    String
  cefrTag     String
  levelName   String
  order       Int
  isPublished Boolean     @default(false)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  weeks       StudyWeek[]
}

model StudyWeek {
  id          String     @id @default(uuid())
  levelId     String
  weekNumber  Int
  phase       String?
  fechas      String
  ejeTematico String
  unidadLibro String
  paginas     String
  kpi         String
  horasJson   Json
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  level       StudyLevel @relation(fields: [levelId], references: [id], onDelete: Cascade)
  lessons     Lesson[]

  @@unique([levelId, weekNumber])
  @@index([levelId])
}

// ═══════════════════════════════════════════════════════════════
// EJERCICIOS
// ═══════════════════════════════════════════════════════════════

model Exercise {
  examQuestions   ExamQuestion[]
  id                  String       @id
  lessonId            String
  skill               Skill
  itemNumber          Int
  questionType        String
  spanishContext      String?
  instruction         String?
  questionText        String
  translationSentence String?
  optionsJson         Json
  optionsTranslation  Json?
  correctAnswer       String
  explanation         String?
  vocabularyHint      String?
  audioUrl            String?
  points              Int          @default(10)
  timeLimitSec        Int          @default(30)
  difficulty          Int          @default(1)
  active              Boolean      @default(true)
  uiDisplay           String?
  instructionTTS      Json?
  audioUI             String?
  audioTTS            Json?
  acceptedAnswers     String[]     @default([])
  aiToolTags          String[]     @default([])
  voz                 String       @default("female")
  vocabLinks          ExerciseVocabulary[]
  perfil              String       @default("")
  fase                String       @default("F1")
  parrafos            Int          @default(1)

  lesson              Lesson       @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  submissions         Submission[]
}

model UserProgress {
  id          String   @id @default(uuid())
  userId      String
  lessonId    String
  completed   Boolean  @default(false)
  score       Float?
  completedAt DateTime @default(now())
  lesson      Lesson   @relation(fields: [lessonId], references: [id], onDelete: Restrict)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
}

model Submission {
  id           String   @id @default(uuid())
  userId       String
  exerciseId   String
  userAnswer   String
  isCorrect    Boolean
  timeSpentSec Int
  createdAt    DateTime @default(now())
  exercise     Exercise @relation(fields: [exerciseId], references: [id], onDelete: Restrict)
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ═══════════════════════════════════════════════════════════════
// PERFILES
// ═══════════════════════════════════════════════════════════════

model DirectorProfile {
  id                    String    @id @default(uuid())
  userId                String    @unique
  phone                 String?
  bio                   String?
  curp                  String?
  birthDate             DateTime?
  degree                String?
  experienceYears       Int       @default(0)
  institutionName       String?
  institutionLogo       String?
  slogan                String?
  instPhone             String?
  address               String?
  instEmail             String?
  facebook              String?
  instagram             String?
  linkedin              String?
  institutionCode       String?   @unique
  institutionType       String?
  carrera1              String?
  carrera2              String?
  carrera3              String?
  carrera4              String?
  carrera5              String?
  carrera6              String?
  carrera7              String?
  turnoMatutino         Boolean   @default(false)
  turnoVespertino       Boolean   @default(false)
  turnoSemiEscolarizado Boolean   @default(false)
  turnoSabatino         Boolean   @default(false)
  turnoDistancia        Boolean   @default(false)
  modalidad             String?
  semestres             String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model TeacherProfile {
  id               String   @id @default(uuid())
  userId           String   @unique
  idEmpleado       String?
  phone            String?
  bio              String?
  curp             String?
  birthDate        DateTime?
  degree           String?
  experienceYears  Int      @default(0)
  specialties      String?
  certifications   String?
  institutionCode  String?
  directorEmail    String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model StudentProfile {
  id               String   @id @default(uuid())
  userId           String   @unique
  studentId        String?
  phone            String?
  bio              String?
  curp             String?
  birthDate        DateTime?
  experienceYears  Int      @default(0)
  numeroControl    String?
  carrera          String?
  turno            String?
  semestre         String?
  moduloTec        String?
  nivelIngles      String?
  institutionCode  String?
  directorEmail    String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ═══════════════════════════════════════════════════════════════
// GRUPOS
// ═══════════════════════════════════════════════════════════════

model EnglishGroup {
  id                String   @id @default(uuid())
  codeId            String   @unique
  nombre            String
  grupo             String
  nivel             String
  carrera           String?
  turno             String?
  docenteEmail      String?
  capacidad         Int      @default(30)
  alumnosInscritos  Int      @default(0)
  status            String   @default("ACTIVE")
  directorEmail     String
  institutionCode   String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  members     GroupMember[]
  attendances Attendance[]
  schedules   EnglishGroupSchedule[]
  conversations Conversation[]
}

model EnglishGroupSchedule {
  id        String   @id @default(uuid())
  groupId   String
  horaInicio String
  horaFin    String
  dias       String
  orden      Int      @default(1)
  createdAt  DateTime @default(now())
  group EnglishGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  @@unique([groupId, orden])
}

model GroupMember {
  id              String   @id @default(uuid())
  groupId         String
  userId          String
  email           String
  nombre          String?
  rolEnGrupo      String   @default("ALUMNO")
  fechaAsignacion DateTime @default(now())
  asignadoPor     String?
  activo          Boolean  @default(true)
  createdAt       DateTime @default(now())
  group EnglishGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([groupId, userId])
}

model Attendance {
  id           String   @id @default(uuid())
  groupId      String
  userId       String
  email        String
  nombre       String?
  fecha        DateTime
  estado       String   @default("PRESENTE")
  horaEntrada  String?
  metodo       String?  @default("MANUAL")
  registradoPor String?
  docenteEmail String?
  tipoLectura  String?  @default("ENTRADA")
  createdAt    DateTime @default(now())
  group EnglishGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([groupId, userId, fecha])
  @@index([groupId, fecha])
  @@index([userId, fecha])
}

// ═══════════════════════════════════════════════════════════════
// METAS Y LOGROS
// ═══════════════════════════════════════════════════════════════

model Goal {
  id          String   @id @default(uuid())
  userId      String
  title       String
  description String?
  targetDate  DateTime?
  progress    Int      @default(0)
  status      String   @default("ACTIVE")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Achievement {
  id          String   @id @default(uuid())
  userId      String
  title       String
  description String?
  icon        String?
  unlockedAt  DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model CalendarEvent {
  id              String   @id @default(uuid())
  day             Int?
  month           Int?
  year            Int?
  title           String
  type            String?
  description     String?
  time            String?
  visibility      String?
  createdBy       String?
  institutionCode String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  @@index([year, month])
  @@index([institutionCode])
}

// ═══════════════════════════════════════════════════════════════
// MENSAJERÍA
// ═══════════════════════════════════════════════════════════════

model Conversation {
  id             String           @id
  type           ConversationType @default(GLOBAL)
  name           String?
  groupId        String?
  createdById    String?
  createdByEmail String?
  lastMessage    String?
  lastMessageAt  DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  group    EnglishGroup?        @relation(fields: [groupId], references: [id], onDelete: SetNull)
  members  ConversationMember[]
  messages Message[]
  @@index([type])
  @@index([groupId])
  @@index([lastMessageAt])
}

model ConversationMember {
  id             String    @id @default(uuid())
  conversationId String
  userId         String
  email          String
  name           String?
  role           String    @default("MEMBER")
  lastReadAt     DateTime?
  joinedAt       DateTime  @default(now())
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([conversationId, userId])
  @@index([userId])
  @@index([email])
}

model Message {
  id             String    @id @default(uuid())
  conversationId String
  senderId       String
  senderEmail    String
  senderName     String?
  senderRole     String?
  content        String
  isDirector     Boolean   @default(false)
  visibleTo      String[]  @default([])
  createdAt      DateTime  @default(now())
  editedAt       DateTime?
  deletedAt      DateTime?
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation(fields: [senderId], references: [id], onDelete: Cascade)
  @@index([conversationId, createdAt])
  @@index([senderId])
}

// ═══════════════════════════════════════════════════════════════
// ENUMS
// ═══════════════════════════════════════════════════════════════

enum ConversationType {
  GLOBAL
  GROUP
  DIRECT
}

enum Role {
  STUDENT
  TEACHER
  ADMIN
}

enum Skill {
  GRAMMAR
  READING
  LISTENING
  SPEAKING
  VOCABULARY
  WRITING
}

// ═══════════════════════════════════════════════════════════════
// VOCABULARIO Y TEXTOS
// ═══════════════════════════════════════════════════════════════

model VocabularyItem {
  id              String   @id @default(uuid())
  lessonId        String
  term            String
  translation     String
  type            String
  ttsText         String
  lang            String   @default("en")
  pronunciationAf String?
  exampleUse      String?
  tags            String[] @default([])
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  lesson          Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  exercises       ExerciseVocabulary[]
  @@index([lessonId])
  @@index([term])
}

model ExerciseVocabulary {
  exerciseId   String
  vocabularyId String
  exercise     Exercise       @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  vocabulary   VocabularyItem @relation(fields: [vocabularyId], references: [id], onDelete: Cascade)
  @@id([exerciseId, vocabularyId])
}

model TextBase {
  id           String   @id @default(uuid())
  lessonId     String
  title        String
  content      String
  translation  String?
  wordCount    Int      @default(0)
  difficulty   Int      @default(1)
  timeAudioSec Int      @default(30)
  vocabList    String[] @default([])
  verbsList    String[] @default([])
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  lesson       Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  @@index([lessonId])
  perfil       String   @default("")
  fase         String   @default("F1")
  parrafos     Int      @default(1)
}

// ═══════════════════════════════════════════════════════════════
// EXÁMENES
// ═══════════════════════════════════════════════════════════════

enum ExamType {
  UBICACION
  INTERMEDIO
  FINAL
}

model Exam {
  questions       ExamQuestion[]
  id              String   @id @default(uuid())
  code            String   @unique
  title           String
  type            ExamType
  weekNumber      Int?
  durationMinutes Int
  totalQuestions  Int
  passingScore    Float
  coverageFrom    String?
  coverageTo      String?
  description     String?
  isPublished     Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  results         ExamResult[]
  @@index([type])
  @@index([weekNumber])
}

model ExamResult {
  id           String   @id @default(uuid())
  userId       String
  examId       String
  score        Float
  percentage   Float
  passed       Boolean
  completedAt  DateTime @default(now())
  exam         Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([userId, examId])
  @@index([userId])
  @@index([examId])
}

model ExamQuestion {
  id          String   @id @default(uuid())
  examId      String
  exerciseId  String
  skill       Skill
  order       Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  exam        Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  exercise    Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  @@unique([examId, exerciseId])
  @@index([examId, skill])
  @@index([exerciseId])
}

// ═══════════════════════════════════════════════════════════════
// TEACHER SCRIPT (BILINGÜE)
// ═══════════════════════════════════════════════════════════════

model TeacherScript {
  id         String   @id @default(uuid())
  lessonId   String   @unique
  title      String
  content    String
  contentEn  String?
  duration   Int      @default(120)
  updatedAt  DateTime @updatedAt
  lesson     Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@index([lessonId])
}

// ═══════════════════════════════════════════════════════════════
// BASE DE CONOCIMIENTOS PEDAGÓGICA
// ═══════════════════════════════════════════════════════════════

model LessonTheorySection {
  id        String   @id @default(uuid())
  lessonId  String
  order     Int
  title     String
  text      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  lesson    Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  @@unique([lessonId, order])
  @@index([lessonId])
}

model SkillTutorial {
  id              String   @id @default(uuid())
  skill           Skill    @unique
  eyebrow         String
  title           String
  explanationText String
  keyPoints       Json
  storageKey      String   @unique
  lang            String   @default("es-MX")
  rate            Float    @default(0.92)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model GrammarTopic {
  id          String   @id
  title       String
  titleEn     String
  mcer        String
  category    String
  summary     String
  explanation String
  structure   String
  keywords    String[] @default([])
  order       Int      @default(0)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  examples    GrammarExample[]
  @@index([mcer])
  @@index([category])
}

model GrammarExample {
  id      String       @id @default(uuid())
  topicId String
  order   Int          @default(0)
  en      String
  es      String
  note    String?
  topic   GrammarTopic @relation(fields: [topicId], references: [id], onDelete: Cascade)
  @@index([topicId])
}

model ClassKnowledgeMap {
  lessonId      String   @id
  grammarTopics String[] @default([])
  vocabTopics   String[] @default([])
  updatedAt     DateTime @updatedAt
  lesson        Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
}

model MallaWeek {
  id            String   @id @default(uuid())
  levelCode     String
  weekNumber    Int
  phase         String?
  lessonIds     String[] @default([])
  isExamWeek    Boolean  @default(false)
  isClosingWeek Boolean  @default(false)
  title         String?
  shortTitle    String?
  mcer          String?
  grammarFocus  String?
  lessons       Lesson[] @relation("MallaWeekLessons")
  @@unique([levelCode, weekNumber])
  @@index([levelCode])
}

model CoursePhase {
  id          String @id @default(uuid())
  code        String @unique
  order       Int
  name        String
  description String
  weekFrom    Int
  weekTo      Int
  block       Int
  mcer        String
}

model ProgramSemester {
  id      String          @id @default(uuid())
  code    String          @unique
  name    String
  order   Int
  cefrTag String
  skills  SemesterSkill[]
}

model SemesterSkill {
  id            String          @id @default(uuid())
  semesterCode  String
  skill         String
  order         Int             @default(0)
  name          String
  englishName   String
  iconKey       String
  kpi           String
  accreditation String
  description   String
  semester      ProgramSemester @relation(fields: [semesterCode], references: [code], onDelete: Cascade)
  @@unique([semesterCode, skill])
  @@index([semesterCode])
}

model ProductionModelText {
  id      String @id
  profile String
  title   String
  theme   String
  text    String
  order   Int    @default(0)
}

model GrammarBlock {
  id         String   @id @default(uuid())
  number     Int      @unique
  name       String
  purpose    String
  mcer       String
  structures String[] @default([])
}

model GrammarStructure {
  id        String  @id @default(uuid())
  structure String  @unique
  block     Int
  mcer      String
  t1        Boolean @default(false)
  t2        Boolean @default(false)
  t3        Boolean @default(false)
}

model VocabBlock {
  id     String   @id
  source String
  label  String
  words  String[] @default([])
  @@index([source])
}

model LessonContract {
  id           String   @id @default(uuid())
  lessonId     String   @unique
  profile      String
  fragment     String
  anchorPhrase String
  vocabBlock   Int
  matrixRows   Int[]    @default([])
  vocabExtra   String[] @default([])
  lesson       Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
}

model LessonCurriculum {
  id              String   @id @default(uuid())
  lessonId        String   @unique
  order           Int      @default(0)
  classCode       String
  topic           String
  description     String
  level           String
  grammarFocus    String
  vocabFocus      String[] @default([])
  keyStructures   String[] @default([])
  suggestedPrompt String
  lesson          Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  @@index([lessonId])
}

model LessonGrammarTip {
  id            String   @id @default(uuid())
  lessonId      String
  title         String
  rule          String
  commonMistake String?
  examples      Json
  lesson        Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  @@index([lessonId])
}

model LessonQuickVocab {
  id          String @id @default(uuid())
  lessonId    String
  order       Int
  word        String
  translation String
  lesson      Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  @@unique([lessonId, order])
  @@index([lessonId])
}

// ═══════════════════════════════════════════════════════════════
// PRESENTACIÓN PERSONAL Y ANALYTICS
// ═══════════════════════════════════════════════════════════════

model StudentPresentation {
  id              String   @id @default(uuid())
  userId          String
  section1Spanish String?
  section2Spanish String?
  section3Spanish String?
  section4Spanish String?
  section5Spanish String?
  section1English String?
  section2English String?
  section3English String?
  section4English String?
  section5English String?
  fullPresentation String?
  status          String   @default("draft")
  timesPracticed  Int      @default(0)
  lastPracticedAt DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([userId])
  @@index([userId])
}

model PronunciationAttempt {
  id           String   @id @default(uuid())
  userId       String
  source       String
  sectionKey   String?
  targetPhrase String
  transcript   String
  score        Int
  missedWords  String[] @default([])
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, createdAt])
  @@index([source])
  @@index([userId, source])
}

model UserSession {
  id          String    @id @default(uuid())
  userId      String
  startedAt   DateTime  @default(now())
  endedAt     DateTime?
  durationSec Int       @default(0)
  device      String?
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, startedAt])
  @@index([startedAt])
}

model UserActivity {
  id        String   @id @default(uuid())
  userId    String
  sessionId String?
  eventType String
  eventData Json?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, createdAt])
  @@index([eventType, createdAt])
}

model PushSubscription {
  id         String   @id @default(uuid())
  userId     String
  endpoint   String   @unique
  p256dh     String
  auth       String
  userAgent  String?
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
}

model NotificationPreference {
  id          String   @id @default(uuid())
  userId      String   @unique
  enabled     Boolean  @default(false)
  daysOfWeek  Int[]    @default([])
  hour        Int      @default(20)
  minute      Int      @default(0)
  timezone    String   @default("America/Mexico_City")
  lastSentAt  DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}
