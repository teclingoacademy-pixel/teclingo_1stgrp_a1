# ============================================================================
# BASE DE DATOS (Prisma + PostgreSQL en Docker)
# ============================================================================
# Levanta la BD con:  docker compose up -d
# Aplica el schema con: npm run db:deploy
#
# La contraseña DEBE coincidir con POSTGRES_PASSWORD de docker-compose.yml.
# Si cambias una, cambia la otra.
DATABASE_URL="postgresql://teclingo_user:tu_password_local@localhost:5432/teclingo_db?schema=public"

# Credenciales que usa docker-compose.yml para inicializar el contenedor.
POSTGRES_DB="teclingo_db"
POSTGRES_USER="teclingo_user"
POSTGRES_PASSWORD="tu_password_local"

# ============================================================================
# BACKEND
# ============================================================================
# Puerto del backend Express (server.ts). El proxy de Vite apunta aqui.
PORT=3000

# Backend Express usado por el frontend en desarrollo.
VITE_API_URL="http://localhost:3000"

# ============================================================================
# SUPABASE (bucket de imagenes para credenciales ID Card)
# ============================================================================
# Ver supabase_storage_setup.sql para crear el bucket y sus politicas RLS.
SUPABASE_URL="https://tu-proyecto.supabase.co"
SUPABASE_BUCKET="TECLINGO INGLES IMAGENES"

# Clave publicable (anon). Alternativa: usar SUPABASE_SERVICE_ROLE_KEY
# (ignora RLS, mas simple pero nunca la expongas al cliente).
SUPABASE_KEY="sb_publishable_tu_clave"

# Opcional: solo si la clave publicable NO basta por las politicas RLS.
# SUPABASE_SERVICE_ROLE_KEY="sb_secret_tu_clave"

# ============================================================================
# IA Y VOZ
# ============================================================================
# GROQ_API_KEY: Required for Groq AI API calls.
# Get your API key at https://console.groq.com
# Set this as an environment variable in Vercel (Production, Preview, Development)
GROQ_API_KEY="your_groq_api_key_here"

# TTS_API_KEY: Required for ElevenLabs Text-to-Speech API (voces premium HD).
# Get your API key at https://elevenlabs.io
# Set this as an environment variable in Vercel (Production, Preview, Development)
TTS_API_KEY="your_elevenlabs_api_key_here"

# APP_URL: The URL where this applet is hosted.
APP_URL="https://your-app.vercel.app"

# VITE_IDENTITY_API_URL: Identity Lake API endpoint (DESPLIEGUE V6 MAIN APP)
VITE_IDENTITY_API_URL="https://script.google.com/macros/s/AKfycbz7buTc2D7FIgWVub6_t4leXfvqc68821957LHOUgP-mBqpWKn_7JaEU-DZWiumAcVb/exec"

# VITE_GOOGLE_CLIENT_ID: Google OAuth Client ID for SSO
VITE_GOOGLE_CLIENT_ID="853891222522-t26sp8ig5kn5vfir05om765vr2i0jsj3.apps.googleusercontent.com"

# VITE_DRIVE_FOLDER_DOCENTES: Google Drive folder ID for teacher certifications
VITE_DRIVE_FOLDER_DOCENTES="your_teacher_certifications_folder_id"

# VITE_DRIVE_FOLDER_ALUMNOS: Google Drive folder ID for student certifications
VITE_DRIVE_FOLDER_ALUMNOS="your_student_certifications_folder_id"

# ============================================================
# PostgreSQL (docker compose)
# ============================================================
DATABASE_URL="postgresql://teclingo_user:password@localhost:5432/teclingo_db?schema=public"
POSTGRES_DB="teclingo_db"
POSTGRES_USER="teclingo_user"
POSTGRES_PASSWORD="password"
POSTGRES_PORT="5432"
PORT=3000

# ============================================================
# OLLAMA — Teacher Virtual / AI Tutor (endpoint /api/ai/ask)
# Solo backend: nunca se expone al navegador.
# Desarrollo (Windows): apuntas al servidor Debian por IP.
# Produccion (Debian): "http://localhost:11434"
# ============================================================
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="llama3.2:3b"
OLLAMA_TIMEOUT_MS="120000"
OLLAMA_NUM_CTX="4096"
